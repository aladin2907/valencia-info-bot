# --- База данных -----------------------------------------------------------
POSTGRES_USER=valencia
POSTGRES_PASSWORD=change_me
POSTGRES_DB=valencia
DATABASE_URL=postgresql://valencia:change_me@localhost:5432/valencia

# --- Модели на своём железе (models/server.py) ------------------------------
MODELS_URL=http://localhost:8081
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# окно 1024 токена: так мерили, и это вдвое быстрее полного 8192
MAX_SEQ_LEN=1024
# cuda / mps / cpu; пусто — определяется само
DEVICE=

# --- LLM (OpenRouter или любой OpenAI-совместимый) --------------------------
OPENROUTER_API_KEY=
# Модель, на которой снимался замер (stealth/ox-alpha), с OpenRouter исчезла.
# minimax-m3 — бесплатная и отвечает нормально, но у бесплатных есть суточный
# предел запросов: для боевого режима нужна платная и деньги на счёте.
OPENROUTER_MODEL=minimax/minimax-m3:free

# Вариант «напрямую в OpenAI» — раскомментировать эти три строки, они главнее
# ключей OpenRouter выше. Подойдёт любой другой совместимый сервис.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Поиск: значения по умолчанию — измеренная конфигурация -----------------
# менять только вместе с новым замером (docs/QUALITY.md)
POOL_SIZE=50
CONTEXT_THREADS=8
ANSWER_MAX_TOKENS=3000
USE_RERANK=1
USE_FTS=0

# --- Не проверено замером: по умолчанию выключено ---------------------------
USE_QUERY_REWRITE=0
USE_RECENCY=0

# --- Telegram --------------------------------------------------------------
# ТЕСТОВЫЙ токен: боевой бот пока работает на старом n8n
TELEGRAM_BOT_TOKEN=            # боевой бот сейчас на n8n; см. docs/DEPLOY.md §7
API_URL=http://localhost:8080
RATE_LIMIT_SECONDS=300
# для докачки истории чатов (my.telegram.org)
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=sessions/valencia_ingest

# --- Ingest ----------------------------------------------------------------
GROUPS=it_ua_valencia,matusi_valencia,valencia_parents_kids_schools
THREAD_REBUILD_DAYS=14
EMBED_BATCH=64
